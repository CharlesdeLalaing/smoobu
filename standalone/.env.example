# ===========================================
# Smoobu Standalone Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# REQUIRED: Smoobu API
# ===========================================
# Get your API key from: https://login.smoobu.com/en/settings/api
SMOOBU_API_KEY=your_smoobu_api_key_here

# ===========================================
# REQUIRED: JWT Authentication
# ===========================================
# Generate a secure random string (at least 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Token expiration (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# ===========================================
# OPTIONAL: Stripe (for payments)
# ===========================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===========================================
# OPTIONAL: Email (for booking confirmations)
# ===========================================
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
EMAIL_PROVIDER=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password

# Email sender display
EMAIL_FROM_NAME=My Property
EMAIL_FROM_ADDRESS=booking@myproperty.com

# ===========================================
# OPTIONAL: Advanced Settings
# ===========================================
# Rate limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100

# Logging level (error, warn, info, debug)
LOG_LEVEL=info
